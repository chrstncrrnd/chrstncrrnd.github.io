---
import BaseLayout from "../layouts/BaseLayout.astro";

const postFiles = import.meta.glob("./posts/*.md", { eager: true });

const posts = Object.entries(postFiles)
    .map(([path, post]) => {
        const slug = path.split("/").pop()?.replace(/\.md$/, "");
        const frontmatter = (
            post as {
                frontmatter: {
                    title: string;
                    description?: string;
                    creation: string;
                    tags?: string[];
                };
            }
        ).frontmatter;

        return {
            title: frontmatter.title,
            description: frontmatter.description,
            creation: frontmatter.creation,
            tags: frontmatter.tags ?? [],
            href: `/posts/${slug}`,
            timestamp: Date.parse(frontmatter.creation),
        };
    })
    .sort((a, b) => b.timestamp - a.timestamp);
---

<BaseLayout>
    <h1 class="posts-heading">Posts:</h1>
    {posts.length > 0 ? (
        <ul class="post-list">
            {posts.map((post) => (
                <li>
                    <time>{post.creation}</time>
                    <article class="post-card">
                        <h2>
                            <a href={post.href}>{post.title}</a>
                        </h2>
                        {post.description && (
                            <p class="description">{post.description}</p>
                        )}
                        {post.tags.length > 0 && (
                            <ul class="tags" aria-label="Tags">
                                {post.tags.map((tag) => (
                                    <li>{tag}</li>
                                ))}
                            </ul>
                        )}
                    </article>
                </li>
            ))}
        </ul>
    ) : (
        <em>Nothing here yet...</em>
    )}
</BaseLayout>

<style>
    .posts-heading {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin: 0.25rem 0 0;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        line-height: 1;
        letter-spacing: -0.035em;
    }

    .post-list {
        display: grid;
        width: 125%;
        margin: 0.75rem -12.5% 0;
        padding: 0;
        list-style: none;
    }

    .post-list > li {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: 1.25rem;
        padding-block: 1rem;
        border-bottom: 1px solid var(--divider-color);
    }

    .post-list > li:last-child {
        border-bottom: 0;
    }

    time {
        padding-top: 0.15rem;
        color: var(--text-color);
        font-size: 0.85rem;
        opacity: 0.55;
        white-space: nowrap;
    }

    .post-card {
        min-width: 0;
    }

    h2 {
        margin: 0 0 0.45rem;
        font-size: 1.15rem;
        line-height: 1.2;
    }

    h2 a {
        color: var(--text-color);
        text-decoration: none;
    }

    h2 a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }

    .description {
        margin: 0;
        font-size: 1rem;
        line-height: 1.55;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        margin: 0.9rem 0 0;
        padding: 0;
        list-style: none;
    }

    .tags li {
        color: var(--text-color);
        font-size: 0.78rem;
        font-style: italic;
        line-height: 1.2;
        opacity: 0.65;
    }

    .tags li:not(:last-child)::after {
        content: "\00a0\00b7\00a0";
        font-style: normal;
    }

    @media (max-width: 640px) {
        .post-list {
            width: 100%;
            margin-inline: 0;
        }

        .post-list > li {
            grid-template-columns: 1fr;
            gap: 0.35rem;
        }
    }
</style>
