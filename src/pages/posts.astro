---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <h1 class="posts-heading">Posts:</h1>
    <PostList />
</BaseLayout>

<style>
    .posts-heading {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin: 0.25rem 0 0;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        line-height: 1;
        letter-spacing: -0.035em;
    }

</style>
