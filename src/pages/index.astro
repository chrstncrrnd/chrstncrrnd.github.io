---
import ProjectCard from "../components/ProjectCard.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="chrstncrrnd">
    <main class="introduction">
        <h1>Hi, I'm Christian</h1>
        <p>
            I'm a mathematics and computer science student interested in
            low-level software engineering, theoretical computer science, and
            pure mathematics. I also enjoy playing the guitar and hiking!
        </p>
        <br />
        <p>
            This website exists as the face to my blog and to harbour some of my
            projects. I started my blog mainly to share my learnings and to
            collect my miscellaneous ideas. Hopefully you find something
            interesting/useful!
        </p>
    </main>
    <div>
        <h2>
            1 - <em>Featured Projects</em>
        </h2>
        <ProjectGrid>
            <ProjectCard
                title="sym_diff"
                description="A symbolic differentiation engine written in Rust. Uses Rust's metaprogramming system to generate differentiation rules based on declarative statements."
                date_begin="April"
                date_end="August 2026"
                image_url="/images/sym_diff_thumb.png"
                link="https://github.com/chrstncrrnd/sym_diff"
                tags={["Rust", "Metaprogramming", "Calculus", "Compilers"]}
            />

            <ProjectCard
                title="C_OS"
                description="Operating system for the RISC-V ISA. Uses Sv39 virtual paging. Currently under development :)"
                date_begin="November 2026"
                date_end="Ongoing"
                image_url="/images/c_os_thumb.png"
                link="https://github.com/chrstncrrnd/c_os"
                tags={["OS", "C", "Embedded"]}
            />
            <ProjectCard
                title="E2EE Chat"
                description="End-to-end encrypted real-time chat app. Using a TLS-inspired key exchange and packet protocol."
                date_begin="October 2025"
                date_end="January 2026"
                image_url="/images/e2ee_thumb.png"
                link="https://example.com"
                tags={["Cryptography", "Python", "Sockets"]}
            />
            <ProjectCard
                title="Group app"
                description="Social network built around the friend group."
                date_begin="March 2023"
                date_end="October 2024"
                image_url="/images/group_app_thumb.png"
                link="https://github.com/chrstncrrnd/group_app"
                tags={["Dart", "Flutter", "Firebase"]}
            />
        </ProjectGrid>
    </div>
    <div>
        <h2>
            2 - <em>Recent Posts</em>
        </h2>
        <PostList limit={3} />
    </div>
</BaseLayout>

<style>
    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.1;
        font-weight: bold;
    }

    p {
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.7;
    }
</style>
