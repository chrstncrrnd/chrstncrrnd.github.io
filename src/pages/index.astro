---
import ProjectCard from "../components/ProjectCard.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="chrstncrrnd">
    <main class="introduction">
        <h1>Hi, I'm Christian</h1>
        <p>
            I'm a mathematics and computer science student interested in
            low-level software engineering, theoretical computer science, and
            pure mathematics.
        </p>
    </main>
    <div>
        <h2>1 - Featured Projects</h2>
        <ProjectGrid>
            <ProjectCard
                title="First Project"
                description="Description of first project"
                date_begin="Jan 23rd 2026"
                image_url="https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/Mandel_zoom_00_mandelbrot_set.jpg/1920px-Mandel_zoom_00_mandelbrot_set.jpg"
                link="https://example.com"
                tags={["project", "software"]}
            />
            <ProjectCard
                title="First Project"
                description="Description of first project"
                date_begin="Jan 23rd 2026"
                image_url="https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/Mandel_zoom_00_mandelbrot_set.jpg/1920px-Mandel_zoom_00_mandelbrot_set.jpg"
                link="https://example.com"
                tags={["project", "software"]}
            />
            <ProjectCard
                title="First Project"
                description="Description of first project"
                date_begin="Jan 23rd 2026"
                image_url="https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/Mandel_zoom_00_mandelbrot_set.jpg/1920px-Mandel_zoom_00_mandelbrot_set.jpg"
                link="https://example.com"
                tags={["project", "software"]}
            />
        </ProjectGrid>
    </div>
    <div>
        <h2>2 - Recent Posts</h2>
        Here go my featured projects
    </div>
</BaseLayout>

<style>
    h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.1;
        font-weight: bold;
    }

    p {
        max-width: 38rem;
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.7;
    }
</style>
