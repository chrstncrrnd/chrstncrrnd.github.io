---
import type { MarkdownLayoutProps } from "astro";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "katex/dist/katex.min.css";
import BaseLayout from "./BaseLayout.astro";

type Props = MarkdownLayoutProps<{
    title: string;
    creation: string;
    latest_edit?: string;
}>;

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — chrstncrrnd`}>
    <article class="post">
        <header class="post-header">
            <a class="back-link" href="/posts">
                &larr; All posts
            </a>
            <h1>{frontmatter.title}</h1>
            <div class="post-meta" aria-label="Post details">
                <span>
                    <time>{frontmatter.creation}</time>
                </span>
                {frontmatter.latest_edit &&
                    frontmatter.latest_edit !== frontmatter.creation && (
                        <span>
                            Updated <time>{frontmatter.latest_edit}</time>
                        </span>
                    )}
            </div>
        </header>

        <hr class="post-divider" />

        <div class="post-content">
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
    .post {
        width: 100%;
        max-width: 46rem;
        margin-inline: auto;
        padding-block: 1.5rem 3.5rem;
    }

    .post-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .back-link {
        margin-bottom: 1.75rem;
        color: var(--muted-text-color);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 150ms ease;
    }

    .back-link:hover {
        color: var(--text-color);
        text-decoration: underline;
        text-decoration-color: var(--accent-color);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
    }

    .post-header h1 {
        max-width: 14ch;
        margin: 0;
        font-size: clamp(2.25rem, 7vw, 4rem);
        line-height: 1.02;
        letter-spacing: -0.035em;
        font-weight: 700;
    }

    .post-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.25rem;
        margin-top: 1.25rem;
        color: var(--muted-text-color);
        font-size: 0.9rem;
    }

    .post-divider {
        border: 0;
        border-top: 1px solid var(--divider-color);
        margin: 2rem 0;
    }

    .post-content {
        font-size: 1.25rem;
        line-height: 1.78;
    }

    .post-content :global(p) {
        margin: 0 0 1.35em;
    }

    /*.post-content :global(h2),
    .post-content :global(h3),
    .post-content :global(h4) {
        scroll-margin-top: 2rem;
        line-height: 1.2;
    }

    .post-content :global(h2) {
        margin: 2.25em 0 0.65em;
        font-size: 1.75rem;
    }

    .post-content :global(h3) {
        margin: 1.75em 0 0.55em;
        font-size: 1.35rem;
    }

    .post-content :global(h4) {
        margin: 1.5em 0 0.5em;
        font-size: 1.15rem;
    }*/

    .post-content :global(a) {
        color: inherit;
        text-decoration-color: var(--accent-color);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
    }

    .post-content :global(a:hover) {
        text-decoration-thickness: 2px;
    }

    .post-content :global(blockquote) {
        margin: 1.75em 0;
        padding: 0.15em 0 0.15em 1.25em;
        border-left: 3px solid var(--accent-color);
        font-style: italic;
    }

    .post-content :global(blockquote p:last-child) {
        margin-bottom: 0;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        margin: 0 0 1.35em;
        padding-left: 1.35em;
    }

    .post-content :global(li) {
        margin-block: 0.35em;
        padding-left: 0.25em;
    }

    .post-content :global(li::marker) {
        color: var(--text-color);
    }

    .post-content :global(code) {
        border: 1px solid var(--divider-color);
        border-radius: 0.25rem;
        background: color-mix(in srgb, var(--text-color) 5%, transparent);
        padding: 0.12em 0.3em;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.82em;
        font-feature-settings:
            "liga" 1,
            "calt" 1;
    }

    .post-content :global(pre) {
        max-width: 100%;
        margin: 1.75em 0;
        overflow-x: auto;
        border: 1px solid var(--divider-color);
        border-radius: 0.5rem;
        background: color-mix(
            in srgb,
            var(--text-color) 4%,
            var(--page-background)
        );
        padding: 1.1rem 1.25rem;
        line-height: 1.55;
        font-family: "JetBrains Mono", monospace !important;
        font-feature-settings:
            "liga" 1,
            "calt" 1;
    }

    .post-content :global(pre code),
    .post-content :global(pre *) {
        border: 0;
        background: transparent;
        padding: 0;
        font-size: 0.86em;
        font-family: "JetBrains Mono", monospace !important;
    }

    .post-content :global(hr) {
        border: 0;
        border-top: 1px solid var(--divider-color);
        margin: 2.5rem 0;
    }

    .post-content :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 2rem auto;
        border-radius: 0.35rem;
    }

    .post-content :global(table) {
        width: 100%;
        margin: 1.75em 0;
        border-collapse: collapse;
        font-size: 0.95em;
    }

    .post-content :global(th),
    .post-content :global(td) {
        border-bottom: 1px solid var(--divider-color);
        padding: 0.65em 0.8em;
        text-align: left;
    }

    .post-content :global(th) {
        border-bottom-width: 2px;
    }

    .post-content :global(.katex-display) {
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding-block: 0.25em;
    }

    @media (max-width: 640px) {
        .post {
            padding-block: 0.75rem 2.5rem;
        }

        .back-link {
            margin-bottom: 1.25rem;
        }

        .post-header h1 {
            font-size: clamp(2.1rem, 12vw, 3.25rem);
        }

        .post-content {
            font-size: 1.15rem;
            line-height: 1.72;
        }
    }
</style>
