---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "computer-modern/cmu-serif.css";
const { title } = Astro.props;
---

<style is:global>
    :root {
        color-scheme: light;
        --page-background: #f7f3e8;
        --text-color: #282826;
        --muted-text-color: #625e55;
        --divider-color: #d1cdbf;
        --accent-color: #875a24;
    }

    :root[data-theme="dark"] {
        color-scheme: dark;
        --page-background: #1b1d20;
        --text-color: #f3f1e9;
        --muted-text-color: #c6c3ba;
        --divider-color: #4b4d50;
        --accent-color: #e3b46d;
    }

    * {
        font-family: "CMU Serif";
    }

    body {
        min-height: 100vh;
        margin: 0;
        background: var(--page-background);
        color: var(--text-color);
        transition:
            background-color 150ms ease,
            color 150ms ease;
    }

    .page {
        width: 100%;
        max-width: 1000px;
        min-height: 100vh;
        margin-inline: auto;
        padding-inline: clamp(0.25rem, 2vw, 1.5rem);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .page > article {
        flex: 1;
        width: 80%;
        margin-inline: auto;
    }
</style>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <script is:inline>
            let storedTheme = null;
            try {
                storedTheme = localStorage.getItem("theme");
            } catch {}

            const systemTheme = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches
                ? "dark"
                : "light";
            document.documentElement.dataset.theme =
                storedTheme === "dark" || storedTheme === "light"
                    ? storedTheme
                    : systemTheme;
        </script>
    </head>
    <body>
        <div class="page">
            <Header />
            <article>
                <slot /> <!-- your content is injected here -->
            </article>
            <Footer />
        </div>
    </body>
</html>
